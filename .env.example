# 이 파일을 복사해 .env.local 로 저장하고 실제 값을 채워 넣으세요.
# .env.local 은 .gitignore에 의해 절대 커밋되지 않습니다.

# Vercel Postgres(Neon) 등에서 발급받은 연결 문자열
# Vercel Storage에서 Postgres를 연결하면 POSTGRES_URL로 자동 주입될 수도 있습니다 (둘 중 하나만 있어도 동작).
DATABASE_URL=

# resend.com 에서 발급받은 API 키
RESEND_API_KEY=

# 관리자 페이지(/admin) 로그인 비밀번호 — 직접 정한 임의의 문자열
ADMIN_PASSWORD=
